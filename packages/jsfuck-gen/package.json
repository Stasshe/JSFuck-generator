{
  "name": "jsfuck-gen",
  "version": "0.1.0",
  "type": "module",
  "description": "JSFuck expression generator and quiz engine.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "biome lint src/**/*.ts tests/**/*.ts",
    "format": "biome format src/**/*.ts tests/**/*.ts --write"
  },
  "keywords": [
    "jsfuck",
    "generator",
    "quiz"
  ],
  "author": "Stasshe",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
